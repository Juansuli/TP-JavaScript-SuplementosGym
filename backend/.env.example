# Copy this file to ".env" (without the ".example") and fill in the
# real values. The ".env" file is never committed to the repo.

PORT=3001

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=suplementos_gym

# Secret used to sign login JWTs. Generate your own (e.g. `node -e
# "console.log(require('crypto').randomBytes(48).toString('hex'))"`),
# never reuse this placeholder outside local dev. Must be at least 32
# characters long or the server refuses to start.
JWT_SECRET=replace_with_a_long_random_string
# Must include a time unit (e.g. "2h", "7200s", "30m"). A bare number
# like "7200" is parsed as MILLISECONDS, not seconds -- the server
# refuses to start with a unit-less value to avoid that trap.
JWT_EXPIRES_IN=2h
